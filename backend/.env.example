# Twilio — from https://console.twilio.com (Account SID + Auth Token on the dashboard)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number you bought, in E.164 format, e.g. +15551234567
TWILIO_PHONE_NUMBER=

# What the caller hears. Change this without touching any code.
HELPLINE_GREETING=Thank you for calling the TerraSense city helpline. What is your emergency?
# Twilio TTS voice. Polly.Aditi is Indian English; Polly.Joanna is US English.
HELPLINE_VOICE=Polly.Aditi
HELPLINE_LANGUAGE=en-IN

# Set to false only if signature checks fail behind a proxy that rewrites the URL.
TWILIO_VALIDATE_SIGNATURE=true

# Backend port. macOS AirPlay Receiver occupies 5000, so this demo uses 5001.
PORT=5001

# Set to true only for local development. Leave false (or unset) in production.
FLASK_DEBUG=false
